# Acción del Sur — variables de entorno del backend
# Copiar a backend/.env y completar. Nunca versionar backend/.env (está en .gitignore).

# ─── Base de datos (MySQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=accion_del_sur
DB_USER=root
DB_PASSWORD=cambiar_esto

# ─── Autenticación (JWT) ─────────────────────────────────────────────────────
# Generar un valor largo y aleatorio, p. ej.:  openssl rand -hex 48
JWT_SECRET=cambiar_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# ─── Servidor ────────────────────────────────────────────────────────────────
# Backend en :3012. En desarrollo, Vite (:5000) hace proxy de /api y /uploads a este puerto;
# en producción lo hace Nginx (ver deploy/README.md).
PORT=3012
# development registra todas las consultas SQL; el servicio systemd fuerza production.
NODE_ENV=development
# Origen permitido por CORS y base de los links públicos (QR de recepciones).
# Desarrollo: http://localhost:5000   ·   Producción detrás de Nginx: http://10.147.19.102
FRONTEND_URL=http://localhost:5000

# ─── Email SMTP (aviso al donante cuando se acepta su donación) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password_de_gmail
SMTP_FROM="Acción del Sur <tu_correo@gmail.com>"

# ─── Blockchain Stellar/Soroban (trazabilidad) ──────────────────────────────
# Con STELLAR_ENABLED=false el sistema funciona completo sin blockchain (todo queda en MySQL).
# Para activarla (ver docs/blockchain.md):
#   npm run stellar:cuenta       → genera y fondea la cuenta admin, completa STELLAR_*_KEY
#   npm run stellar:desplegar    → despliega los contratos, completa SOROBAN_* y CENTRO_WASM_HASH
#   npm run stellar:sincronizar  → contratos de centros + carga del stock existente
STELLAR_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_PUBLIC_KEY=
STELLAR_SECRET_KEY=
SOROBAN_CONTRACT_SFT=
SOROBAN_CONTRACT_ENTREGAS=
CENTRO_WASM_HASH=
# Opcionales (tienen valores por defecto):
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_TX_TIMEOUT_SEC=120
# STELLAR_POLL_INTERVAL_MS=1500
