# Acción del Sur — variables de entorno del backend
# Copiar a backend/.env y completar. Nunca versionar backend/.env (está en .gitignore).

# ─── Base de datos (MySQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=accion_del_sur_proyecto
DB_USER=root
DB_PASSWORD=cambiar_esto

# ─── Autenticación (JWT) ─────────────────────────────────────────────────────
# Generar un valor largo y aleatorio, p. ej.:  openssl rand -hex 48
JWT_SECRET=cambiar_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# ─── Servidor ────────────────────────────────────────────────────────────────
# Backend en :3012. En desarrollo, Vite (:5000) hace proxy de /api y /uploads a este puerto;
# en producción lo hace Nginx (ver deploy/README.md).
PORT=3012
# development registra todas las consultas SQL; el servicio systemd fuerza production.
NODE_ENV=development
# Origen permitido por CORS y base de los links públicos (QR de recepciones).
# Desarrollo: http://localhost:5000   ·   Producción detrás de Nginx: http://10.147.19.102
FRONTEND_URL=http://localhost:5000

# ─── Email SMTP (aviso al donante cuando se acepta su donación) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password_de_gmail
SMTP_FROM="Acción del Sur <tu_correo@gmail.com>"

# ─── Blockchain Stellar/Soroban (opcional, fuera del alcance del acta) ──────
# Con STELLAR_ENABLED=false el sistema funciona completo sin blockchain.
STELLAR_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=
# Opcionales (tienen valores por defecto para testnet):
# STELLAR_RPC_URL=
# STELLAR_TX_TIMEOUT_SEC=
# STELLAR_POLL_INTERVAL_MS=
SOROBAN_CONTRACT_ID=
SOROBAN_CONTRACT_DONACIONES=
SOROBAN_CONTRACT_ENTREGAS=
SOROBAN_CONTRACT_SFT=
CENTRO_WASM_HASH=

# ─── Asistente de consultas (LLM vía OpenCode, opcional) ────────────────────
# El backend no las lee directamente: las usa el agente OpenCode de backend/chatLLM
# (credenciales de base de solo lectura en backend/chatLLM/.env, ver su .env.example).
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=https://api.openai.com/v1
# OPENCODE_CONFIG=
