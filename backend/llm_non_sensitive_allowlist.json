{
  "database": "accion_del_sur",
  "tables": {
    "usuarios": { "allowedColumns": ["id", "role"], "deniedColumns": ["email", "password"] },
    "donantes": { "allowedColumns": ["id", "name", "city", "registered_by"], "deniedColumns": ["contact"] },
    "donaciones": { "allowedColumns": ["id", "date", "donor_id", "registered_by"], "deniedColumns": [] },
    "categorias": { "allowedColumns": ["id", "name", "parent_category_id"], "deniedColumns": [] },
    "insumos": { "allowedColumns": ["id", "name", "available_quantity", "category_id"], "deniedColumns": [] },
    "donaciones_insumos": { "allowedColumns": ["donation_id", "supply_id"], "deniedColumns": [] },
    "centros_recepcion": { "allowedColumns": ["id", "name", "location", "operational_status", "managed_by"], "deniedColumns": [] },
    "envios": { "allowedColumns": ["id", "date", "reception_center_id", "registered_by", "confirmed"], "deniedColumns": [] },
    "detalles_envio": { "allowedColumns": ["id", "shipment_id", "supply_id", "quantity_sent"], "deniedColumns": [] }
  },
  "excludedSensitiveColumns": ["usuarios.email", "usuarios.password", "donantes.contact"]
}
